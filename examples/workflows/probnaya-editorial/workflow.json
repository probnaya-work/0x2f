        {
          "id": "cancellation",
          "match": "cancel an active run",
          "title": "Stopping a run, keeping the task",
          "description": "0x2F can now stop an active agent run through its shared lifecycle.",
          "detail": "The local implementation exposes cancellation in the CLI, TUI and Web. The worker asks the adapter to stop and records the outcome while preserving the task and its run history. This change has not been verified in a public release.",
          "visual": {
            "kind": "diagram",
            "nodes": [
              "STOP REQUEST",
              "ADAPTER CANCEL",
              "RUN HISTORY"
            ],
            "caption": "IMPLEMENTATION DIAGRAM / TASK AND RUN HISTORY PERSIST",
            "layout": "cancellation",
            "heading": "0x2F",
            "subheading": "STOPPING A RUN · KEEPING THE TASK",
            "stateLabel": "IMPLEMENTED LOCALLY",
            "stateDetail": "RUN CANCELLATION / 0x2F",
            "specimen": "IMPLEMENTATION DIAGRAM · NO MEASUREMENT CLAIMED",
            "statement": "The run stops. The task and its history remain.",
            "rows": [
              [
                "SCOPE",
                "ACTIVE RUN · FINISHED RESULT PRESERVED"
              ],
              [
                "OUTCOME",
                "FAILED · KIND CANCELLED"
              ],
              [
                "RETENTION",
                "TASK · CONTEXT · RUN HISTORY"
              ],
              [
                "RELEASE",
                "PUBLIC RELEASE NOT VERIFIED"
              ],
              [
                "SURFACE",
                "0x2F.SPACE"
              ]
            ]
          }
        },
        {
          "id": "opencode-acp",
          "match": "OpenCode.*ACP",
          "title": "OpenCode joins the work router",
          "description": "0x2F now includes an OpenCode adapter through ACP.",
          "detail": "The local implementation starts opencode acp in the project directory. OpenCode uses its own project configuration while 0x2F retains the task, run history and permission decisions. This change has not been verified in a public release.",
          "visual": {
            "kind": "diagram",
            "nodes": [
              "0x2F TASK",
              "ACP",
              "OPENCODE"
            ],
            "caption": "IMPLEMENTATION DIAGRAM / ONE TASK, DISPOSABLE AGENT SESSIONS"
          }
        }
      ]
    },
